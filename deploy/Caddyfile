# Add this block to the server's Caddyfile (usually /etc/caddy/Caddyfile),
# then reload:  sudo systemctl reload caddy
# Caddy obtains and renews HTTPS automatically — no certbot needed.
# Change the domain; the port must match WEB_PORT in .env.local.

scores.yourdomain.com {
    reverse_proxy 127.0.0.1:3100
}
