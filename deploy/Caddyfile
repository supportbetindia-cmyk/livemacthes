# Add these blocks to the server's Caddyfile (usually /etc/caddy/Caddyfile),
# then reload:  sudo systemctl reload caddy
# Caddy obtains and renews HTTPS automatically — no certbot needed.
# The port must match WEB_PORT in .env.local.

livematch.co {
    reverse_proxy 127.0.0.1:3100
}

www.livematch.co {
    redir https://livematch.co{uri} permanent
}
