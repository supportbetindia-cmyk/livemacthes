# Copy to .env.local on the server and fill in real values. NEVER commit .env.local.
# Required vars have no default; optional ones show the fallback the code uses.

# ---- Site ----
SITE_URL=https://yourdomain.com          # required in prod; defaults to http://localhost:3000
SITE_NAME=LiveScore                       # optional; shown as the brand / news source
LOGO_URL=                                 # optional; overrides the bundled logo
LOGO_DARK_URL=                            # optional; dark-mode logo
NEXT_PUBLIC_DISABLE_IMAGE_OPTIMIZATION=   # optional; set to 1 to serve images unoptimized

# ---- Sportmonks (cricket data provider) ----
SPORTMONKS_API_TOKEN=                      # required
SPORTMONKS_DAILY_LIMIT=2000                # optional; daily call budget (default 2000)
SPORTMONKS_BUDGET_BATCH=10                 # optional; calls per batch (default 10)
SPORTMONKS_WORKER_RESERVE=1000             # optional; calls reserved for the worker (default 1000)
SPORTMONKS_BUDGET_DATABASE_URL=            # optional; defaults to NEXT_PUBLIC_FIREBASE_DATABASE_URL

# ---- Firebase (Realtime Database cache + worker) ----
NEXT_PUBLIC_FIREBASE_DATABASE_URL=         # required; your RTDB URL
FIREBASE_SERVICE_ACCOUNT=                  # required for server writes; service-account JSON, or base64 of it

# ---- Sanity (news articles; optional if unused) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_REVALIDATE_SECRET=                  # optional; shared secret for the revalidate webhook
